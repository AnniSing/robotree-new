{
  "name": "robotree-careers-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 3000",
    "backend:build": "tsc",
    "backend:dev": "tsx backend/src/server.ts",
    "backend": "npm run backend:build && node dist-server/server.js",
    "backend:legacy": "node server.js",
    "start": "npm run backend:build && node server.js",
    "test": "npm run backend:build && node --test",
    "check": "npm run test && npm run build",
    "audit": "npm audit --omit=dev",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "verify:production": "node scripts/verify-production.js",
    "db:verify": "node scripts/verify-mongodb.js",
    "db:sync": "node scripts/sync-mongodb.js",
    "db:supabase:migrate": "node scripts/sync-supabase.js",
    "db:supabase:verify": "node scripts/verify-supabase.js",
    "db:supabase:seed": "node scripts/seed-via-api.js",
    "db:migrate": "node scripts/sync-supabase.js",
    "db:seed": "node scripts/seed-via-api.js",
    "photos:gather": "node scripts/gather-all-photos.js",
    "build": "vite build",
    "postbuild": "node -e \"import('node:fs').then(fs => { fs.cpSync('assets', 'dist/assets', {recursive: true, force: true}); if(fs.existsSync('robots.txt')) fs.copyFileSync('robots.txt', 'dist/robots.txt'); if(fs.existsSync('sitemap.xml')) fs.copyFileSync('sitemap.xml', 'dist/sitemap.xml'); })\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "ws": "^8.22.1",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
