NODE_ENV=production
PORT=5000

# Replace every value below before deployment.
ADMIN_PASSCODE=replace-with-strong-admin-passcode
SESSION_SECRET=replace-with-64-plus-character-random-secret
ADMIN_TOKEN_TTL_MS=7200000
USER_TOKEN_TTL_MS=604800000

# Public frontend/API origins allowed to call the backend.
ALLOWED_ORIGINS=https://robotree.org,https://www.robotree.org

# JSON database location. Use a persistent mounted volume in production.
ROBOTREE_DATA_DIR=/var/lib/robotree/data

# CDN/static asset controls. The backend sets browser, CDN, and surrogate cache headers.
STATIC_ASSET_CDN_ORIGIN=https://cdn.robotree.org
CDN_CACHE_SECONDS=31536000
