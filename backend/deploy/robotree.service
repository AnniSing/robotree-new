[Unit]
Description=Robotree Robotics Production Backend
After=network.target

[Service]
Type=simple
User=robotree
Group=robotree
WorkingDirectory=/var/www/robotree
EnvironmentFile=/var/www/robotree/backend/config/production.env
ExecStart=/usr/bin/node backend/src/start.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robotree /var/www/robotree/data /var/www/robotree/backups
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
