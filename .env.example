# ==============================================================================
# ROBOTREE ROBOTICS LLP — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Administrative Security Passcode (Keep this secret and never commit to git)
ADMIN_PASSCODE=your_production_admin_passcode_here

# Session & JWT Cryptographic Signing Secret
SESSION_SECRET=robotree_super_secure_production_secret_key_change_me_in_prod
ADMIN_TOKEN_TTL_MS=7200000
USER_TOKEN_TTL_MS=604800000

# Allowed CORS Origins (comma-separated list of trusted frontend domains)
# Note: Vercel preview URLs (*.vercel.app) and same-host origins are automatically permitted
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,https://robotree.in

# ==============================================================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
# Option 1: Supabase Connection String (Transaction Pooler - Recommended for Vercel)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Option 2: Supabase API Access (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Optional: Set DB provider explicitly ('auto', 'supabase', 'postgres', or 'json')
DB_PROVIDER=auto

# Optional persistent data directory and CDN asset controls (for local fallback)
ROBOTREE_DATA_DIR=./data
STATIC_ASSET_CDN_ORIGIN=
CDN_CACHE_SECONDS=31536000
LOG_LEVEL=info
